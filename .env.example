# ------------------------------------------------------------------
# CentroManager — variables d'environnement
# Copier ce fichier en .env.local puis renseigner les valeurs.
# ------------------------------------------------------------------

# URL publique de l'application (liens, redirections d'authentification).
# En local : http://localhost:3000 — sur Vercel : l'URL de production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL de l'API Supabase.
# En local : http://127.0.0.1:55321 (ports 5532x, voir supabase/config.toml).
# En production : Tableau de bord Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321

# Clé publique (PUBLISHABLE_KEY ou ANON_KEY). Exposée au navigateur, protégée par RLS.
# En local : valeur PUBLISHABLE_KEY affichée par `npm run db:status`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète (SECRET_KEY ou SERVICE_ROLE_KEY). SERVEUR UNIQUEMENT :
# utilisée par les Server Actions de création de comptes.
# Ne jamais la préfixer par NEXT_PUBLIC_, ne jamais l'importer côté client.
# En local : valeur SECRET_KEY affichée par `npm run db:status`.
SUPABASE_SERVICE_ROLE_KEY=
