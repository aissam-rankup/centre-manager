# ------------------------------------------------------------------
# CentroManager — variables d'environnement
# Copier ce fichier en .env.local puis renseigner les valeurs.
# ------------------------------------------------------------------

# URL publique de l'application (liens, redirections d'authentification).
# En local : http://localhost:3000 — sur Vercel : l'URL de production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Projet Supabase — Tableau de bord > Project Settings > API.
# En local, `npx supabase status` affiche ces valeurs.
NEXT_PUBLIC_SUPABASE_URL=
# Clé publique (anon / publishable). Exposée au navigateur, protégée par RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role (secret). SERVEUR UNIQUEMENT : utilisée par les Server Actions
# de création de comptes. Ne jamais la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
